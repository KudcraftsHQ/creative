{
  "name": "@creative/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "bun --hot run src/index.ts",
    "build": "bun build src/index.ts --target=bun --outdir=dist --external @prisma/client --external .prisma/client --external @napi-rs/canvas",
    "typecheck": "tsc --noEmit",
    "test": "bun test tests/",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "worker": "bun run src/worker.ts",
    "user:upsert": "bun run scripts/upsert-user.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.658.0",
    "@aws-sdk/s3-request-presigner": "^3.658.0",
    "@creative/core": "workspace:*",
    "@hono/zod-validator": "^0.4.1",
    "@napi-rs/canvas": "^1.0.6",
    "@prisma/client": "^5.22.0",
    "better-auth": "^1.0.21",
    "hono": "^4.6.10",
    "ioredis": "^5.4.1",
    "prisma": "^5.22.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.6.3"
  }
}
