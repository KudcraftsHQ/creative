# Through PgBouncer. Prisma needs both flags: transaction pooling breaks prepared
# statements, and one connection per client keeps the shared pooler usable.
DATABASE_URL="postgres://user:pass@pgbouncer-shared-...:5432/creative-db?pgbouncer=true&connection_limit=1"
# Straight at Postgres. Migrations need a session, which the pooler cannot give them.
DIRECT_URL="postgres://user:pass@n4okooo:5432/creative-db"

# The event hub. Without it the web app and the worker cannot hear each other.
REDIS_URL="redis://:pass@redis-primary:6379"

BETTER_AUTH_SECRET="generate with: openssl rand -base64 32"
BETTER_AUTH_URL="https://creative.kudcrafts.com"
APP_URL="https://creative.kudcrafts.com"
# Extra origins allowed to hold a session, comma-separated.
TRUSTED_ORIGINS=""

PORT=3000
TZ=Asia/Jakarta

# Optional. Without a bucket, previews are rendered on demand and the worker idles.
S3_BUCKET=""
S3_REGION="auto"
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
